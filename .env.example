# =========================================================================
# Manga2Motion Environment Configuration
# =========================================================================

# --- Execution Engine Mode ---
# Set to 'true' to offload image generation to an open-source free API
# Set to 'false' to run SDXL / AnimateDiff directly on local GPU inside container
USE_IMAGE_API=false

# --- Free / Open-Source Image Generation API Providers ---
# Options:
# 1) 'pollinations'   : 100% Free, public open-source generative API. No registration or API keys needed.
# 2) 'huggingface'    : Hugging Face Serverless Inference API (requires free HF_TOKEN below).
# 3) 'local_sd_api'   : Connects to local containerized SD-WebUI / ComfyUI API (http://sd-api:7860).
IMAGE_API_PROVIDER=pollinations

# --- Hugging Face Free API Configuration (Optional) ---
HF_TOKEN=
HF_MODEL=cagliostrolab/animagine-xl-3.1

# --- Local Containerized SD-WebUI / ComfyUI API Endpoint ---
LOCAL_SD_API_URL=http://sd-api:7860

# --- General System Settings ---
ENABLE_FREE_API_FALLBACK=true
GRADIO_SERVER_PORT=7860
TOTAL_FRAMES=30
FPS=24
